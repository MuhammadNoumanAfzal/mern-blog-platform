  <div id="admin-content">
      <div class="container">
      <div class="row">
        <div class="col-md-12">
            <h1 class="admin-heading">Update Article</h1>
        </div>
        <div class="col-md-8 mx-auto">
          <div class="card">
            <h5 class="card-header">Update Article</h5>
            <div class="card-body">
              <!-- Form -->
              <form action="/admin/update-article/<%= article._id %>" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="article_title" class="form-label">Title</label>
                    <input type="text" name="title" id="article_title" class="form-control" autocomplete="off" value="<%= article.newsTitle %>" required>
                </div>
                <div class="mb-3">
                    <label for="summernote" class="form-label">Description</label>
                    <textarea name="content" id="summernote" class="form-control" rows="5"  required><%= article.newsDescription %></textarea>
                </div>
                <div class="mb-3">
                    <label for="article_category" class="form-label">Category</label>
                    <select name="category" id="article_category" class="form-control">
                        <!-- <option value="" selected> Select Category</option> -->
                        <% categories.forEach(category => { %>
                            <option value="<%= category._id %>" <%= category._id == article.category._id ? 'selected' : '' %>><%= category.categoryName %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="article_image" class="form-label">Article image</label>
                    <br>
                    <img src="/uploads/<%= article.newsImage %>" alt="Article Image mb-3 w-25 border-3 border-primary" class="img-fluid mb-2">
                    <input type="file" name="newsImage" id="article_image" class="form-control" required>
                </div>
                <input type="submit" name="submit" class="btn btn-primary" value="Update" />
              </form>
              <!--/Form -->
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>