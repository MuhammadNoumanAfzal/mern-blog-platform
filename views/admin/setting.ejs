<div id="admin-content">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <h1 class="admin-heading"><i class="fa fa-cog"></i> Settings</h1>
      </div>

      <div class="col-md-6 mx-auto">
        <div class="card">
          <h5 class="card-header">Settings</h5>

          <div class="card-body">
            <form action="/admin/save-setting" method="POST" enctype="multipart/form-data">

              <!-- Website Title -->
              <div class="mb-3">
                <label for="website_title" class="form-label">Website Title</label>

                <% if (setting) { %>
                  <input
                    type="text"
                    name="website_title"
                    class="form-control"
                    autocomplete="off"
                    value="<%= setting.website_title %>"
                    required
                  />
                <% } else { %>
                  <input
                    type="text"
                    name="website_title"
                    class="form-control"
                    autocomplete="off"
                    required
                  />
                <% } %>
              </div>

              <!-- Website Logo -->
              <div class="mb-3">
                <label for="website_logo" class="form-label">Upload Logo</label>

                <% if (setting && setting.website_logo) { %>
                  <img
                    src="/uploads/<%= setting.website_logo %>"
                    alt="Current Logo"
                    class="img-fluid mb-2"
                    style="max-height:100px;"
                  />
                <% } %>

                <input
                  type="file"
                  name="website_logo"
                  class="form-control"
                  <%= (!setting || !setting.website_logo) ? 'required' : '' %>
                />
              </div>

              <!-- Footer Description -->
              <div class="mb-3">
                <label for="footer_description" class="form-label">
                  Footer Description
                </label>

                <% if (setting && setting.footer_description) { %>
                  <input
                    type="text"
                    name="footer_description"
                    class="form-control"
                    autocomplete="off"
                    value="<%= setting.footer_description %>"
                    required
                  />
                <% } else { %>
                  <input
                    type="text"
                    name="footer_description"
                    class="form-control"
                    autocomplete="off"
                    required
                  />
                <% } %>
              </div>

              <input
                type="submit"
                name="submit"
                class="btn btn-primary"
                value="Save"
              />

            </form>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>