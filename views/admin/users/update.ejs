<div id="admin-content">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <h1 class="admin-heading">Modify User Details</h1>
      </div>

      <div class="col-md-6 mx-auto">
        <div class="card">
          <h5 class="card-header">Update User</h5>

          <div class="card-body">
            <!-- Form Start -->
            <form action="/admin/update-user/<%= user._id %>" method="POST" autocomplete="off">

              <!-- Full Name (Readonly - will still be submitted) -->
              <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input
                  type="text"
                  name="fullName"
                  class="form-control"
                  placeholder="Full Name"
                  value="<%= user.fullName %>"
                  readonly
                />
              </div>

              <!-- User Name -->
              <div class="mb-3">
                <label class="form-label">User Name</label>
                <input
                  type="text"
                  name="userName"
                  class="form-control"
                  placeholder="Username"
                  value="<%= user.userName %>"
                  required
                />
              </div>

              <!-- Password (Optional) -->
              <div class="mb-3">
                <label class="form-label">Password</label>
                <input
                  type="password"
                  name="password"
                  class="form-control"
                  placeholder="Leave blank to keep current password"
                />
                <small class="text-muted">
                  Leave blank if you don't want to change the password.
                </small>
              </div>

              <!-- User Role -->
              <div class="mb-3">
                <label class="form-label">User Role</label>
                <select class="form-control" name="role" required>
                  <option value="author" <%= user.role === "author" ? "selected" : "" %>>
                    Author
                  </option>
                  <option value="admin" <%= user.role === "admin" ? "selected" : "" %>>
                    Administrator
                  </option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary">
                Update
              </button>

            </form>
            <!-- Form End -->
          </div>
        </div>
      </div>
    </div>
  </div>
</div>